	    </action-listener>
	    <navigation-handler>
	        org.primefaces.application.DialogNavigationHandler
	    </navigation-handler>
	    <view-handler>
	        org.primefaces.application.DialogViewHandler
	    </view-handler>
    </application-->
</faces-config>
